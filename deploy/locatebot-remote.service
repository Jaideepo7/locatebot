# systemd unit for the Pi's Telegram remote-control service (tools/remote_run.py).
# Install: adjust User / WorkingDirectory / paths, then
#   sudo cp deploy/locatebot-remote.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now locatebot-remote
# Secrets live in the repo's .env (git-ignored, chmod 600), never in this file.
[Unit]
Description=locatebot remote control (Photon/Telegram) on the Pi
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=locatebot
WorkingDirectory=/opt/locatebot
ExecStart=/opt/locatebot/.venv/bin/python tools/remote_run.py --env-file /opt/locatebot/.env --host 127.0.0.1 --port 8070
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10
MemoryMax=150M
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
