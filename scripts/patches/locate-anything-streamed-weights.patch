+// Streaming variant of offload_weights: ctx_ holds metadata only (no_alloc),
+// so each tensor's bytes are read from the gguf file straight into the device
+// buffer (via a reused staging buffer) or, for the two host-read tensors, into
+// a small CPU buffer. Peak host memory is one tensor instead of the whole file.
+bool ModelLoader::offload_streamed(ggml_backend_t backend, const std::string& dev_name){
+    const size_t n = tensors_.size();
+    ggml_init_params dp{};
+    dp.mem_size = ggml_tensor_overhead() * (n + 8);
+    dp.no_alloc = true;
+    device_ctx_ = ggml_init(dp);
+    ggml_init_params hp{};
+    hp.mem_size = ggml_tensor_overhead() * 8;
+    hp.no_alloc = true;
+    host_ctx_ = ggml_init(hp);
+    if (!device_ctx_ || !host_ctx_){ LA_LOG("offload_streamed: ctx init failed"); return false; }
+
+    struct Job { ggml_tensor* dst; size_t off; bool host; };
+    std::vector<Job> jobs; jobs.reserve(n);
+    std::unordered_map<std::string, ggml_tensor*> newmap; newmap.reserve(n);
+    const size_t data_off = gguf_get_data_offset(gguf_);
+    size_t n_dev = 0, n_host = 0, max_dev = 0;
+    for (auto& kv : tensors_) {
+        const bool host = is_host_read_tensor(kv.first);
+        ggml_tensor* s = kv.second;
+        ggml_tensor* d = ggml_new_tensor(host ? host_ctx_ : device_ctx_, s->type, GGML_MAX_DIMS, s->ne);
+        ggml_set_name(d, kv.first.c_str());
+        const int64_t tid = gguf_find_tensor(gguf_, kv.first.c_str());
+        if (tid < 0){ LA_LOG("offload_streamed: tensor %s not in gguf", kv.first.c_str()); return false; }
+        if (gguf_get_tensor_size(gguf_, tid) != ggml_nbytes(d)){
+            LA_LOG("offload_streamed: size mismatch for %s", kv.first.c_str()); return false;
+        }
+        newmap.emplace(kv.first, d);
+        jobs.push_back({d, data_off + gguf_get_tensor_offset(gguf_, tid), host});
+        if (host) ++n_host; else { ++n_dev; if (ggml_nbytes(d) > max_dev) max_dev = ggml_nbytes(d); }
+    }
+    gpu_buf_ = ggml_backend_alloc_ctx_tensors(device_ctx_, backend);
+    if (!gpu_buf_){ LA_LOG("offload_streamed: device alloc failed"); return false; }
+    if (n_host > 0) {
+        host_buf_ = ggml_backend_alloc_ctx_tensors_from_buft(host_ctx_, ggml_backend_cpu_buffer_type());
+        if (!host_buf_){ LA_LOG("offload_streamed: host alloc failed"); return false; }
+    }
+
+    FILE* f = std::fopen(path_.c_str(), "rb");
+    if (!f){ LA_LOG("offload_streamed: cannot reopen %s", path_.c_str()); return false; }
+    std::vector<unsigned char> staging(max_dev);
+    bool ok = true;
+    for (auto& j : jobs) {
+        const size_t nb = ggml_nbytes(j.dst);
+        void* dst = j.host ? j.dst->data : staging.data();
+        if (fseeko(f, (off_t)j.off, SEEK_SET) != 0 || std::fread(dst, 1, nb, f) != nb){
+            LA_LOG("offload_streamed: read failed for %s", ggml_get_name(j.dst)); ok = false; break;
+        }
+        if (!j.host) ggml_backend_tensor_set(j.dst, staging.data(), 0, nb);
+    }
+    std::fclose(f);
+    if (!ok) return false;
+    tensors_.swap(newmap);   // graphs now reference the device-resident weights
+    LA_LOG("offload_weights: streamed %zu weights -> %s, %zu host-read tensors on CPU",
+           n_dev, dev_name.c_str(), n_host);
+    return true;
+}
+
 ModelLoader::~ModelLoader(){
     // Free the device buffer + its metadata ctx BEFORE the host ctx_ (which holds
     // the host-read tensors and the source bytes the device weights were copied from).
     if (gpu_buf_)    ggml_backend_buffer_free(gpu_buf_);
     if (device_ctx_) ggml_free(device_ctx_);
+    if (host_buf_)   ggml_backend_buffer_free(host_buf_);
+    if (host_ctx_)   ggml_free(host_ctx_);
     if (gguf_) gguf_free(gguf_);
     if (ctx_)  ggml_free(ctx_);
 }
