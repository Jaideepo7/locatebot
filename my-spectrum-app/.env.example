SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# iMessage through Spectrum Cloud (needs only the project id/secret above)
IMESSAGE_ENABLED=1
# Telegram: leave empty to turn it off
SPECTRUM_TELEGRAM_BOT_TOKEN=
# Orin operator page (tools/orin_run.py). Use http://<orin-ip>:8090 if the bot runs on another machine.
ROBOT_URL=http://127.0.0.1:8090
# Set RESTRICT_SENDERS=1 to only allow ALLOWED_SENDERS (default: anyone can use the bot).
RESTRICT_SENDERS=
# Who may drive the robot when restricted: phone numbers in +1... format, Apple ID emails, Telegram chat ids. Comma-separated.
# Message the bot once to see your exact id in the refusal reply.
ALLOWED_SENDERS=
