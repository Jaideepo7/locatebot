# Remote control on the Raspberry Pi (tools/remote_run.py). Copy to .env (git-ignored) and fill in.
# Never commit real values. Formats are from the Photon Beta (2.0) API: https://photon.codes/docs/beta/api-reference

# Project API key, starts with pho_sk_ (Photon dashboard -> project -> API keys)
PHOTON_API_KEY=
# Project id, starts with pho_prj_
PHOTON_PROJECT_ID=

# Optional: signing secret of a webhook destination, starts with whsec_ (only for webhook delivery,
# which needs a public HTTPS URL / tunnel to the Pi). Leave empty to disable the webhook route.
PHOTON_WEBHOOK_SECRET=

# Optional: bearer token for the local operator API /api/missions*; at least 32 characters.
# Leave empty to disable the operator API.
OPERATOR_API_TOKEN=

# Optional
# PHOTON_MODE=live            # "console" prints replies instead of sending them (local testing)
# ROBOT_ID=locatebot
# DISPATCH_DB_PATH=dispatch.db
# MISSION_TTL_S=600
# ACK_TIMEOUT_S=10
# LINK_GRACE_S=15
