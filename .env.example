# Remote control on the Raspberry Pi (tools/remote_run.py). Copy to .env (git-ignored) and fill in.
# Never commit real values. Formats are from the Photon Beta (2.0) API: https://photon.codes/docs/beta/api-reference

# Project API key, starts with pho_sk_ (Photon dashboard -> project -> API keys)
PHOTON_API_KEY=
# Project id, starts with pho_prj_
PHOTON_PROJECT_ID=

# How events arrive: "websocket" (default; the Pi dials out, no public URL, needs PHOTON_API_KEY)
# or "webhook" (Photon POSTs to a public HTTPS URL / tunnel; needs PHOTON_WEBHOOK_SECRET).
# PHOTON_INBOUND=websocket

# Webhook mode only: signing secret of the webhook destination, starts with whsec_
PHOTON_WEBHOOK_SECRET=

# Optional: bearer token for the local operator API /api/missions*; at least 32 characters.
# Leave empty to disable the operator API.
OPERATOR_API_TOKEN=

# Optional
# PHOTON_MODE=live            # "console" prints replies instead of sending them (local testing)
# PHOTON_API_VERSION=         # pin the event payload version, e.g. 2026-07-01 (default: Photon's)
# PHOTON_API_ORIGIN=https://api.photon.codes
# ROBOT_ID=locatebot
# DISPATCH_DB_PATH=dispatch.db
# MISSION_TTL_S=600
# ACK_TIMEOUT_S=10
# LINK_GRACE_S=15

# Nemotron (NVIDIA-hosted LLM, build.nvidia.com) and the store-guide agent (tools/store_agent.py)
NVIDIA_API_KEY=
STORE_CODE=
