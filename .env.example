# Copy to .env (git-ignored) and fill in. Never commit real values.
# Formats are from the Photon Beta (2.0) API: https://photon.codes/docs/beta/api-reference

# Project API key, starts with pho_sk_ (Photon dashboard -> project -> API keys)
PHOTON_API_KEY=
# Project id, starts with pho_prj_
PHOTON_PROJECT_ID=
# Signing secret of the webhook destination, starts with whsec_ (shown once when the destination is created)
PHOTON_WEBHOOK_SECRET=

# Must match what the Jetson sends in X-Device-Id
JETSON_DEVICE_ID=
# Shared secret the Jetson sends as "Authorization: Bearer <token>"; at least 32 characters
JETSON_AUTH_TOKEN=

# Public HTTPS base URL Photon posts to (webhook = $BACKEND_PUBLIC_URL/api/photon/webhook)
BACKEND_PUBLIC_URL=

# Bearer token for the operator REST endpoints /api/missions*; at least 32 characters
OPERATOR_API_TOKEN=

# Optional
# PHOTON_MODE=live            # "console" prints replies instead of sending them (local testing)
# DISPATCH_DB_PATH=dispatch.db
# MISSION_TTL_S=600
# ACK_TIMEOUT_S=10
# LINK_GRACE_S=15
